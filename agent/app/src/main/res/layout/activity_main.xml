<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/agent_background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_main_header"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="48dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_header_title"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:letterSpacing="0.02"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.88"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    tools:text="Agent 版本：2.1.17" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMainScanQr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_scan_qr"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 设备概况卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/AppManagerSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_section_device" />

                    <TextView
                        android:id="@+id/tvDeviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/agent_text_primary"
                        android:textSize="14sp"
                        tools:text="分组: 默认\n别名: 测试机\n机器码: xxx" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MDM 状态卡片：仅在 MDM 模式激活时显示（代码控制 visibility） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mdm_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FF6B35">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- 标题行：图标 + "MDM 托管中" + 企业标识 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔒 MDM 托管中"
                            android:textColor="#FF6B35"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMdmEnterprise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1AFF6B35"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textColor="#FF6B35"
                            android:textSize="12sp"
                            tools:text="企业: prod-corp" />
                    </LinearLayout>

                    <!-- Device Owner 徽章 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvMdmOwnerBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textSize="12sp"
                            tools:text="Device Owner ✓" />

                        <TextView
                            android:id="@+id/tvMdmWriteSecure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textSize="12sp"
                            tools:text="WRITE_SECURE ✓" />
                    </LinearLayout>

                    <!-- 活跃策略列表 -->
                    <TextView
                        android:id="@+id/tvMdmPolicies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/agent_text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:visibility="gone"
                        tools:text="• 相机已禁用\n• 禁止截屏\n• 密码强度: 字母+数字，最短6位" />

                    <!-- 分割线 -->
                    <View
                        android:id="@+id/dividerMdmAction"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp"
                        android:background="#15000000"
                        android:visibility="gone" />

                    <!-- 步骤一：设备管理员未激活时显示激活按钮 -->
                    <LinearLayout
                        android:id="@+id/layout_activate_da"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="第一步：激活设备管理员（允许接收策略指令）"
                            android:textColor="#E65100"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_activate_da"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="立即激活设备管理员"
                            android:textSize="14sp"
                            app:backgroundTint="#FF6B35"
                            style="@style/Widget.MaterialComponents.Button" />
                    </LinearLayout>

                    <!-- 步骤二：已激活 DA，引导 DO 激活（显示 ADB 命令） -->
                    <LinearLayout
                        android:id="@+id/layout_activate_do"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="第二步：激活 Device Owner（高级策略，需 USB ADB）"
                            android:textColor="#1565C0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="在电脑上执行（设备通过USB连接，确保无Google账号）："
                            android:textColor="@color/agent_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDoAdbCommand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="#F0F4FF"
                            android:padding="10dp"
                            android:textColor="#1A237E"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_do_command"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="复制命令"
                                android:textSize="13sp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:strokeColor="#1565C0" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_scan_do_qr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="📷 扫码激活"
                                android:textSize="13sp"
                                app:backgroundTint="#4CAF50"
                                style="@style/Widget.MaterialComponents.Button" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_do_refresh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="已激活，刷新状态"
                                android:textSize="13sp"
                                app:backgroundTint="#1565C0"
                                style="@style/Widget.MaterialComponents.Button" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
                 手机/平板也可随时用（换服务器、重新归属）。focusable 便于遥控器聚焦。 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReverseRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:focusable="true"
                android:text="@string/reverse_register_entry"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_menu_share"
                app:iconGravity="textStart" />

            <!-- 前台应用区域标题 -->
            <TextView
                style="@style/AppManagerSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/main_section_front" />

            <!-- 动态前台磁贴区：个人中心（固定）+ 推送的前台菜单（运行时填充） -->
            <LinearLayout
                android:id="@+id/container_front_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 进入后台 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_backend_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_manage"
                        android:contentDescription="@string/main_tile_backend"
                        app:tint="@color/agent_tile_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/main_tile_backend"
                        android:textColor="@color/agent_text_primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription=""
                        app:tint="@color/agent_tile_icon_tint"
                        android:alpha="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
