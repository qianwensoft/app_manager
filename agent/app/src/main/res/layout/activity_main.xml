<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/agent_background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏：品牌 + 版本 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_main_header"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_header_title"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:letterSpacing="0.02"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.88"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:text="Agent 版本：2.1.13" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 设备概况 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/AppManagerSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_section_device" />

                    <TextView
                        android:id="@+id/tvDeviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/agent_text_primary"
                        android:textSize="14sp"
                        tools:text="分组: 默认\n别名: 测试机\n设备号: xxx" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/AppManagerSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/main_section_shortcuts" />

            <!-- 3×3 快捷入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_personal"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_personal"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_personal" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_runtime_perm"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_runtime_perm"
                                android:src="@android:drawable/ic_lock_idle_lock"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_runtime_perm" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_settings"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_settings"
                                android:src="@android:drawable/ic_menu_preferences"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_settings" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_app_list"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_app_list"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                android:id="@+id/tv_tile_scada_label"
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_scada" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_device_info"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_device"
                                android:src="@android:drawable/ic_menu_info_details"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_device" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_perm_mgmt"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_perm_mgmt"
                                android:src="@android:drawable/ic_menu_manage"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_perm_mgmt" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_outbound"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_outbound"
                                android:src="@android:drawable/ic_menu_share"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_outbound" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_custom_events"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_custom_events"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_custom_events" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_tile_listen_state"
                        style="@style/AppManagerGridTile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout style="@style/AppManagerGridTileInner">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/main_tile_listen_state"
                                android:src="@android:drawable/ic_lock_idle_alarm"
                                app:tint="@color/agent_tile_icon_tint" />

                            <TextView
                                style="@style/AppManagerGridTileLabel"
                                android:text="@string/main_tile_listen_state" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
