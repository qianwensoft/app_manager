<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppManagerSectionTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/agent_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="AppManagerGridTile" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_margin">6dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/agent_surface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="AppManagerGridTilePlaceholder" parent="AppManagerGridTile">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:foreground">@null</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">#E8EEF5</item>
    </style>

    <style name="AppManagerGridTileInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">96dp</item>
    </style>

    <style name="AppManagerGridTileLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/agent_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
