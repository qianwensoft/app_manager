# 复制到本机 server 目录下的 uploads（与 config.yaml storage.path 一致，默认 ./uploads）
# export SERVER_DIR="/path/to/app-manager/server"

# 调用「应用管理」上传接口（需管理员/运维 JWT）
# export APP_MANAGER_TOKEN="eyJhbGciOiJIUzI1NiIs..."

# 默认 http://127.0.0.1:8080/api/apps/upload
# export UPLOAD_URL="http://127.0.0.1:8080/api/apps/upload"

# 显式指定 uploads 目录（不设置则用 $SERVER_DIR/uploads）
# export STORAGE_PATH="/path/to/uploads"

# 上传到应用管理时的描述（可选；不设则脚本自动生成「Agent debug/release 构建 日期时间」）
# export APP_UPLOAD_DESCRIPTION="内测版 Agent，修复 WebSocket 重连"

# 多设备时指定序列号（与 sync-agent-apk.sh --install 配合）
# export ANDROID_SERIAL="emulator-5554"
